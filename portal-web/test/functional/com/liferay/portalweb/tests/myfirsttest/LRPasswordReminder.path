<!DOCTYPE html>
<html>
<head>
	<title>LRPasswordReminder</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRPasswordReminder</td></tr>	
</thead>	
<tbody>
<tr>
	<td>QUESTION_SELECT</td>
	<td>//option[contains(@value,'phone-number')]</td>
	<td></td>
</tr>
<tr>
	<td>ANSWER_FIELD</td>
	<td>//input[contains(@id,'QueryAnswer')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>	
</tbody>	
</table>
</body>
</html>