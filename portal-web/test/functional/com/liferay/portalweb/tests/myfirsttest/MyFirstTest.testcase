@component-name = "portal-web-smoke"
definition {
	property testray.main.component.name = "Smoke";

@description = "Ensure that the super admin can login successful."
	@priority = "5"
	test SuperAdminLogin{

    	Open(locator1 = "http://localhost:8080");

		AssertClick(locator1 = "//span[contains(@class,'sign-in')]/a",
			value1 = "http://localhost:8080/c/portal/login?p l id=2");

    	Type(locator1 = "LRLogin#EMAIL_ADDRESS_FIELD", 
    		value1 = "test@liferay.com");
    	Type(locator1 = "LRLogin#PASSWORD_FIELD", 
    		value1 = "test");
	
    	AssertTextEquals(locator1 = "LRLogin#EMAIL_ADDRESS_FIELD", 
    		value1 = "test@liferay.com");
        AssertTextEquals(locator1 = "LRLogin#PASSWORD_FIELD", 
        	value1 = "test");

    	AssertClick(locator1 = "LRLogin#SIGN_IN_BUTTON", 
    		value1 = "Sign In");

    	AssertClick(locator1 = "LRTermsOfUse#I_AGREE",
    		value1 = "I Agree");

    	Select(locator1 = "LRPasswordReminder#QUESTION_SELECT");

    	Type(locator1 = "LRPasswordReminder#ANSWER_FIELD",
    		value1 = "13450200527");

		AssertClick(locator1 = "LRPasswordReminder#SAVE_BUTTON",
			value1 = "Save");

		AssertElementPresent(locator1 = "USER_AVATAR_LINK");
        
	}
}