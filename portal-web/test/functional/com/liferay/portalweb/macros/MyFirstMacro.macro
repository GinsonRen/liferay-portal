definition {
	macro login {
		Open(locator1 = "http://localhost:8080");

		var key_linkName = "Sign In";

		AssertClick(locator1 = "LRLogin#SIGN_IN_LINK", value1 = "Sign In");

		Type(locator1 = "LRLogin#EMAIL_ADDRESS_FIELD", value1 = "${userEmailAddress}");
		Type(locator1 = "LRLogin#PASSWORD_FIELD", value1 = "${userPassword});

		var key_buttonName = "Sign In";

		AssertClick(locator1 = "LRLogin#SIGN_IN_BUTTON", value1 = "Sign In");

		var key_buttonName = "I Agree";

		if(IsElementPresent(locator1 = "LRLogin#SIGN_IN_BUTTON")) {

			AssertClick(locator1 = "LRLogin#SIGN_IN_BUTTON", value1 = "I Agree");

			var key_typeName = "What is your father's middle name?";

			AssertClick(locator1 = "LRPasswordReminder#CLICK_PASSWORD_REMINDER_BUTTON", value1 = "What is your father's middle name?");

			Select(locator1 = "LRPasswordReminder#SELECT_PASSWORD_REMINDER_OPTION");

			Type(locator1 = "LRPasswordReminder#ANSWER_FIELD", value1 = "${userPasswordReminder}");

			var key_buttonName = "Save";

			AssertClick(locator1 = "LRLogin#SIGN_IN_BUTTON", value1 = "Save");
		}
	}

	macro viewLogin {
		AssertTextEquals(locator1 = "LRWelcome#SIGN_IN_PORTLET_TEXT", value1 = "${userFullName}");
	}
}