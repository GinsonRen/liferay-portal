definition {

	macro login {
		Open(locator1 = "http://localhost:8080");

		AssertClick(locator1 = "JCLogin#USER_LOGIN_PORTLET_LINK", value1 = "Sign In");
 
		Type(locator1 = "JCLogin#EMAIL_ADDRESS_FIELD",
			 value1 = "${userEmailAddress}");
		Type(locator1 = "JCLogin#PASSWORD_FIELD",
			 value1 = "${userPassWord}");

		var key_buttonName = "Sign In";

		AssertClick(locator1 = "JCLogin#SIGN_IN_BUTTON", value1 = "Sign In");

		if (IsElementPresent(locator1 = "JCTermsOfUse#I_AGREE_BUTTON")) {
			AssertClick(locator1 = "JCTermsOfUse#I_AGREE_BUTTON", value1 = "I Agree");
		}

		if (IsElementPresent(locator1 = "JCPasswordReminder#ANSWER_FIELD")) {
			Select(locator1 = "JCPasswordReminder#QUESTION_FIELD", value1 = "${questionOption}");

			Type(locator1 = "JCPasswordReminder#ANSWER_FIELD", value1 = "${userPassWordReminder}");

			var key_buttonName = "Save";

			AssertClick(locator1 = "JCLogin#SIGN_IN_BUTTON", value1 = "Save");		
		}
	}

	macro viewLogin {
		AssertElementPresent(locator1 = "JCWelcome#USER_ICON");
	}
}