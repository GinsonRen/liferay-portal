definition{

	macro login {
		Open(locator1 = "http://localhost:8080");

		AssertClick(
			locator1 = "LRLogin#SIGN_IN_LINK",
			value1 = "Sign In");

		Type(
			locator1 = "LRLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");
		Type(
			locator1 = "LRLogin#PASSWORD_FIELD",
			value1 = "${password}");

		AssertClick(
			key_buttonName = "Sign In",
			locator1 = "LRButton#BUTTON",
			value1 = "Sign In");

		if (IsElementPresent(key_buttonName = "I Agree"，locator1 = "LRButton#BUTTON")) {
			AssertClick(
				key_buttonName = "I Agree",
				locator1 = "LRButton#BUTTON",
				value1 = "I Agree");
		}

		if (IsElementPresent(locator1 = "LRNewPassword#NEW_PASSWORD_FIELD")) {
			Type(
				locator1 = "LRNewPassword#NEW_PASSWORD_FIELD",
				value1 = "${newPassword}");
			Type(
				locator1 = "LRNewPassword#ENTER_AGAIN_FIELD",
				value1 = "${newPassword}");

			AssertClick(
				key_buttonName = "Save",
				locator1 = "LRButton#BUTTON",
				value1 = "Save");
		}

		if (IsElementPresent(locator1 = "LRPasswordReminder#QUESTION_SELECT")) {
			Select(
				locator1 = "LRPasswordReminder#QUESTION_SELECT",
				value1 = "What was your first phone number?");

			Type(
				locator1 = "LRPasswordReminder#ANSWER_FIELD",
				value1 = "${passwordReminderAnswer}");

			AssertClick(
				key_buttonName = "Save",
				locator1 = "LRButton#BUTTON",
				value1 = "Save");
		}
	}

	macro viewLogin {
		Click(locator1 = "LRWelcome#USER_AVATAR_LINK");

		AssertTextEquals(
			key_userFullName = "${userFullName}",
			locator1 = "LRWelcome#USER_FULL_NAME",
			value1 = "${userFullName}");
	}

}